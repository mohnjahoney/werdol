{
  "name": "werdol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "analytics:smoke": "node --experimental-strip-types scripts/live-analytics-smoke-test.ts",
    "analytics:publish": "node --experimental-strip-types scripts/publish-analytics-schema.ts",
    "experiment:ngram": "node --experimental-strip-types scripts/query-ngram.ts",
    "experiment:label-familiarity": "node --experimental-strip-types scripts/label-word-familiarity.ts",
    "experiment:ngram-plot": "python3 scripts/plot-ngram-histogram.py docs/allowed-words-ngram.json docs/allowed-words-familiarity-labels.json docs/allowed-words-familiarity-histogram.png",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
